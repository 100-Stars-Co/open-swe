{
  "name": "openswe-js",
  "version": "0.1.0",
  "description": "Open SWE — AI coding agent (TypeScript rewrite using deepagents JS + LangGraph)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "tsc --noEmit",
    "run": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "worker": "bun run src/worker.ts",
    "worker:watch": "bun run --watch src/worker.ts",
    "db:init": "bun run src/db/init.ts",
    "thread:state": "bun src/cli/threadState.ts",
    "compile": "tsc",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "lint:fix": "biome check --write src tests"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.6",
    "@anthropic-ai/sdk": "^0.40.0",
    "@daytona/sdk": "^0.164.0",
    "@hono/node-server": "^1.13.7",
    "@langchain/anthropic": "^0.3.14",
    "@langchain/core": "^1.1.39",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.0",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/ollama": "^1.2.6",
    "deepagents": "^1.9.0",
    "hono": "^4.7.5",
    "bullmq": "^5.71.1",
    "ioredis": "^5.8.2",
    "jose": "^5.10.0",
    "langchain": "^1.3.1",
    "langfuse": "^3.38.20",
    "langfuse-langchain": "^3.38.20",
    "postgres": "^3.4.7",
    "turndown": "^7.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "latest",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.8.3"
  }
}
