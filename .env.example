# LLM (required)
ANTHROPIC_API_KEY=

# Configurable model (default: anthropic:claude-opus-4-6)
DEEPAGENTS_MODEL=anthropic:claude-opus-4-6

# GitHub App (all required)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM string, newlines as \n
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Jira (required for Jira integration)
JIRA_BASE_URL=                 # e.g. https://mycompany.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_WEBHOOK_SECRET=           # optional; if absent, skip verification

# Sandbox
SANDBOX_TYPE=daytona           # daytona | local

# Daytona (required when SANDBOX_TYPE=daytona)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Token storage encryption
TOKEN_ENCRYPTION_KEY=          # 32-byte base64 AES key (generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('base64'))")

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=openswe-js

# State persistence
DATABASE_URL=postgres://postgres:postgres@localhost:5432/openswe_js

# Queue
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_QUEUE_DB=1

# Org allowlist (comma-separated; empty = allow all)
ALLOWED_GITHUB_ORGS=

# Default repo when not inferable from context
DEFAULT_REPO_OWNER=
DEFAULT_REPO_NAME=

# Telegram (required for Telegram trigger)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_REPO_OWNER=           # fallback repo owner for Telegram messages without repo:owner/name
TELEGRAM_REPO_NAME=            # fallback repo name for Telegram messages without repo:owner/name

# Web search (optional)
EXA_API_KEY=
