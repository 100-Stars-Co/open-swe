# LLM (required)
ANTHROPIC_API_KEY=

# Configurable model (default: anthropic:claude-opus-4-6)
DEEPAGENTS_MODEL=anthropic:claude-opus-4-6

# GitHub App (all required)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=        # PEM string, newlines as \n
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Jira (required for Jira integration)
JIRA_BASE_URL=                 # e.g. https://mycompany.atlassian.net
JIRA_API_TOKEN=
JIRA_USER_EMAIL=
JIRA_WEBHOOK_SECRET=           # optional; if absent, skip verification

# Sandbox
SANDBOX_TYPE=daytona           # daytona | local

# Daytona (required when SANDBOX_TYPE=daytona)
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api

# Token storage encryption
TOKEN_ENCRYPTION_KEY=          # 32-byte base64 AES key (generate with: node -e "const c=require('crypto');console.log(c.randomBytes(32).toString('base64'))")

# LangSmith tracing (optional)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=openswe-js

# LangGraph deployment
LANGGRAPH_API_URL=http://localhost:2024

# Org allowlist (comma-separated; empty = allow all)
ALLOWED_GITHUB_ORGS=

# Default repo when not inferable from context
DEFAULT_REPO_OWNER=
DEFAULT_REPO_NAME=

# Web search (optional)
EXA_API_KEY=
